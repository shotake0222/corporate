{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers（静的アセット配信のみ・サーバー処理なし）
  "name": "in-ones-corporate",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
